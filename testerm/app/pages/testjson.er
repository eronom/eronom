import { router } from "std/http"

let app = router()

app.get('/testjson', (c) => {
  let startTime = now()
  
  let user = null
  let errorMsg = null
  
  let res = fetch('https://randomuser.me/api/')
  if (res == null) {
    errorMsg = 'API request failed'
  } else {
    let data = res.json()
    if (data == null) {
      errorMsg = 'Failed to parse JSON'
    } else {
      user = data.results[0]
    }
  }
  
  let endTime = now()
  let duration = endTime - startTime
  let renderedAt = localTimeString()
  
  let html = render("testerm/app/pages/testjson.erm", {
    user: user,
    error: errorMsg,
    serverRenderedAt: renderedAt,
    fetchDurationMs: duration
  })
  
  return c.html(html)
})
