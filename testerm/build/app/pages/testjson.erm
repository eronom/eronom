<script>
    let userFirstName = useState('Loading...');
    let userLastName = useState('');
    let userLoginName = useState('username');
    let userEmail = useState('email@example.com');
    let userCity = useState('City');
    let userCountry = useState('Country');
    let userAge = useState('0');
    let userDob = useState('0000-00-00');
    let userGender = useState('unknown');
    let errorMsg = useState('');

    async function fetchUser() {
        errorMsg = '';
        
        const card = document.querySelector('.card');
        const btn = document.querySelector('.btn-generate');
        
        if (card) card.classList.add('is-loading');
        if (btn) btn.disabled = true;

        try {
            const res = await fetch('https://randomuser.me/api/');
            if (!res.ok) {
                throw new Error('Server returned an error status: ' + res.status);
            }
            const data = await res.json();
            if (data && data.results && data.results.length > 0) {
                const u = data.results[0];
                
                // Update state variables (using distinct names to avoid compiler word conflict)
                userFirstName = u.name.first;
                userLastName = u.name.last;
                userLoginName = u.login.username;
                userEmail = u.email;
                userCity = u.location.city;
                userCountry = u.location.country;
                userAge = u.dob.age;
                userDob = u.dob.date.substring(0, 10);
                userGender = u.gender;

                // Manually update the avatar image
                const avatar = document.querySelector('.avatar');
                if (avatar) {
                    avatar.src = u.picture.large;
                }
            } else {
                throw new Error('No user data returned from the API.');
            }
        } catch (err) {
            errorMsg = err.message || 'Failed to connect to the RandomUser API.';
            console.error('Error fetching user:', err);
        } finally {
            if (card) card.classList.remove('is-loading');
            if (btn) btn.disabled = false;
        }
    }

    // Trigger initial fetch on load (via setTimeout to let DOM render first)
    setTimeout(fetchUser, 50);
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    .body-wrapper {
        font-family: 'Outfit', sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #090d16 100%);
        color: #f8fafc;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        box-sizing: border-box;
    }

    .container {
        width: 100%;
        max-width: 480px;
        position: relative;
    }

    .card {
        background: rgba(17, 24, 39, 0.45);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        padding: 36px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        text-align: center;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        position: relative;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899);
    }

    /* Skeleton & Profile toggles */
    .skeleton-element {
        display: none;
    }

    .card.is-loading .skeleton-element {
        display: block;
    }

    .card.is-loading .spinner.skeleton-element {
        display: inline-block;
    }

    .card.is-loading .profile-element {
        display: none !important;
    }

    .avatar-container {
        position: relative;
        width: 128px;
        height: 128px;
        margin: 0 auto 24px;
    }

    .avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 4px solid rgba(99, 102, 241, 0.2);
        object-fit: cover;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .avatar:hover {
        transform: scale(1.06) rotate(3deg);
        border-color: rgba(99, 102, 241, 0.6);
        box-shadow: 0 16px 36px rgba(99, 102, 241, 0.25);
    }

    .gender-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        color: #e2e8f0;
        padding: 4px 10px;
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .name {
        font-size: 1.9rem;
        font-weight: 700;
        margin: 0 0 6px 0;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, #ffffff 40%, #cbd5e1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .username {
        color: #818cf8;
        font-size: 0.95rem;
        margin-bottom: 28px;
        font-weight: 500;
        letter-spacing: 0.25px;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: left;
        margin-bottom: 32px;
    }

    .info-item {
        background: rgba(15, 23, 42, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.2s ease;
    }

    .info-item:hover {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(255, 255, 255, 0.08);
        transform: translateX(2px);
    }

    .info-icon {
        font-size: 1.25rem;
        background: rgba(99, 102, 241, 0.1);
        color: #818cf8;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(99, 102, 241, 0.15);
    }

    .info-content {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .info-label {
        font-size: 0.72rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.75px;
        margin-bottom: 3px;
        font-weight: 600;
    }

    .info-value {
        font-size: 0.95rem;
        color: #e2e8f0;
        font-weight: 450;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .btn-generate {
        width: 100%;
        background: linear-gradient(90deg, #6366f1, #a855f7);
        color: white;
        border: none;
        border-radius: 16px;
        padding: 16px;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .btn-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(99, 102, 241, 0.5);
        background: linear-gradient(90deg, #4f46e5, #9333ea);
    }

    .btn-generate:active {
        transform: translateY(0);
    }

    .btn-generate:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    /* Skeleton Shimmer Loading States */
    .skeleton-avatar {
        width: 128px;
        height: 128px;
        border-radius: 50%;
        margin: 0 auto 24px;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }

    .skeleton-text {
        height: 20px;
        margin: 10px auto;
        border-radius: 6px;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }

    .skeleton-title {
        width: 65%;
        height: 32px;
    }

    .skeleton-subtitle {
        width: 45%;
        height: 18px;
        margin-bottom: 28px;
    }

    .skeleton-info {
        height: 68px;
        border-radius: 16px;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        margin-bottom: 14px;
    }

    @keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* Error card styling */
    .error-banner {
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        padding: 16px;
        border-radius: 14px;
        text-align: center;
        margin-bottom: 24px;
        font-size: 0.95rem;
    }

    .error-banner:empty {
        display: none !important;
    }

    .home-link-container {
        text-align: center;
        margin-top: 24px;
    }

    .home-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .home-link:hover {
        color: #818cf8;
    }

    /* Spinner */
    .spinner {
        border: 2px solid rgba(255, 255, 255, 0.3);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border-left-color: white;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="body-wrapper">
    <div class="container">
        <div class="card is-loading">
            <!-- Loading Skeletons -->
            <div class="skeleton-avatar skeleton-element"></div>
            <div class="skeleton-text skeleton-title skeleton-element"></div>
            <div class="skeleton-text skeleton-subtitle skeleton-element"></div>
            <div class="skeleton-info skeleton-element"></div>
            <div class="skeleton-info skeleton-element"></div>
            <div class="skeleton-info skeleton-element"></div>

            <!-- Profile Info -->
            <div class="avatar-container profile-element">
                <img class="avatar" src="" alt="Random User Avatar" />
                <span class="gender-badge">{userGender}</span>
            </div>
            
            <h1 class="name profile-element">{userFirstName} {userLastName}</h1>
            <div class="username profile-element">@{userLoginName}</div>

            <div class="info-list profile-element">
                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-content">
                        <span class="info-label">Email Address</span>
                        <span class="info-value">{userEmail}</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📍</div>
                    <div class="info-content">
                        <span class="info-label">Location</span>
                        <span class="info-value">{userCity}, {userCountry}</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">🎂</div>
                    <div class="info-content">
                        <span class="info-label">Age & DOB</span>
                        <span class="info-value">{userAge} years old ({userDob})</span>
                    </div>
                </div>
            </div>

            <!-- Error Banner -->
            <div class="error-banner">{errorMsg}</div>

            <!-- Action Button -->
            <button class="btn-generate" onClick={fetchUser}>
                <div class="spinner skeleton-element"></div>
                <span class="skeleton-element">Discovering profile...</span>
                <span class="profile-element">Fetch Next User</span>
            </button>
        </div>

        <div class="home-link-container">
            <Link to="/" class="home-link">← Back to Dashboard</Link>
        </div>
    </div>
</div>