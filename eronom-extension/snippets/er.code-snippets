{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "\t$0",
      "}"
    ],
    "description": "Declare a function"
  },
  "Let Declaration": {
    "prefix": "let",
    "body": [
      "let ${1:variable} = ${2:value};"
    ],
    "description": "Declare a mutable variable"
  },
  "Const Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:variable} = ${2:value};"
    ],
    "description": "Declare a constant variable"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "\t$0",
      "}"
    ],
    "description": "Declare a struct"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\t${2:method}(${3:params}): ${4:ReturnType};",
      "\t$0",
      "}"
    ],
    "description": "Declare an interface"
  },
  "Embed": {
    "prefix": "embed",
    "body": [
      "embed ${1:StructName};"
    ],
    "description": "Embed a struct (flat struct composition)"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import { ${1:members} } from \"${2:module}\";"
    ],
    "description": "Import members from a module"
  },
  "Export": {
    "prefix": "export",
    "body": [
      "export const ${1:name} = ${2:value};"
    ],
    "description": "Export a value"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:expression});"
    ],
    "description": "Print to console"
  }
}
