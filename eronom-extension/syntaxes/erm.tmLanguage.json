{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eronom Markup",
  "scopeName": "source.erm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#doctype"
    },
    {
      "include": "#script-block"
    },
    {
      "include": "#style-block"
    },
    {
      "include": "#component-function"
    },
    {
      "include": "#top-level-script"
    },
    {
      "include": "#control-blocks"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#tag-close"
    },
    {
      "include": "#fragment"
    },
    {
      "include": "#tag-open"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.html",
          "begin": "<!--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          },
          "end": "-->",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          }
        },
        {
          "name": "comment.block.erm",
          "begin": "\\{/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.erm"
            }
          },
          "end": "\\*/\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.erm"
            }
          }
        },
        {
          "name": "comment.line.erm",
          "match": "\\{//.*?\\}"
        },
        {
          "name": "comment.block.erm",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.erm"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.erm"
            }
          }
        },
        {
          "name": "comment.line.double-slash.erm",
          "begin": "(?<!:)//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.erm"
            }
          },
          "end": "$"
        }
      ]
    },
    "doctype": {
      "begin": "(<!)([dD][oO][cC][tT][yY][pP][eE])\\s+",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.html"
        }
      },
      "name": "meta.tag.metadata.doctype.html",
      "patterns": [
        {
          "match": "[a-zA-Z0-9]+",
          "name": "entity.other.attribute-name.html"
        }
      ]
    },
    "component-function": {
      "name": "meta.function.component.erm",
      "begin": "^\\s*(?:(export)\\s+(?:(default)\\s+)?)?(?:(async)\\s+)?(function|fn)\\b(?:\\s+([a-zA-Z_$][a-zA-Z0-9_$]*))?\\s*(?:(\\()([^)]*)(\\)))?\\s*(?::\\s*([^{]+))?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.js"
        },
        "2": {
          "name": "keyword.control.default.js"
        },
        "3": {
          "name": "storage.modifier.async.js"
        },
        "4": {
          "name": "storage.type.function.js"
        },
        "5": {
          "name": "entity.name.function.js"
        },
        "6": {
          "name": "punctuation.definition.parameters.begin.bracket.round.js"
        },
        "7": {
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        "8": {
          "name": "punctuation.definition.parameters.end.bracket.round.js"
        },
        "9": {
          "name": "entity.name.type.js"
        },
        "10": {
          "name": "punctuation.definition.block.bracket.curly.begin.js"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.bracket.curly.end.js"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#control-blocks"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#tag-close"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#tag-open"
        },
        {
          "name": "keyword.declaration.er",
          "match": "\\b(fn|struct|embed|interface)\\b"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "top-level-script": {
      "name": "meta.embedded.block.javascript",
      "begin": "\\A(?=\\s*(?:export\\b|import\\b|let\\b|const\\b|var\\b|fn\\b|function\\b|class\\b|struct\\b|interface\\b|//|/\\*))",
      "end": "(?m)^(?=\\s*(?:\\<|return\\b|if\\s|for\\s))",
      "patterns": [
        {
          "name": "keyword.declaration.er",
          "match": "\\b(fn|struct|embed|interface)\\b"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "script-block": {
      "begin": "(<)(script)\\b([^>]*)(\\s*)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.script.html"
        },
        "3": {
          "patterns": [
            {
              "include": "#tag-attributes"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.script.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "style-block": {
      "begin": "(<)(style)\\b([^>]*)(\\s*)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.style.html"
        },
        "3": {
          "patterns": [
            {
              "include": "#tag-attributes"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.style.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.embedded.block.css",
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "control-blocks": {
      "patterns": [
        {
          "match": "(@)(else\\s+if|elseif|else|if|for|empty|each|switch|case|default|render)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.keyword.erm keyword.control.er"
            },
            "2": {
              "name": "keyword.control.directive.erm keyword.control.er"
            }
          }
        },
        {
          "name": "keyword.control.er",
          "match": "\\b(if|else\\s+if|else|for|in|return)\\b"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.bracket.curly.begin.er"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.bracket.curly.end.er"
        }
      },
      "name": "meta.embedded.expression.er",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "tag-close": {
      "match": "(</)([a-zA-Z0-9_\\-:]+)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.tag.other.html"
    },
    "fragment": {
      "match": "(<)(/)?(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.tag.other.html"
    },
    "tag-open": {
      "begin": "(<)([a-zA-Z0-9_\\-:]+)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.tag.other.html",
      "patterns": [
        {
          "include": "#tag-attributes"
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "begin": "([a-zA-Z0-9_\\-:@.]+)\\s*(=)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "punctuation.definition.bracket.curly.begin.er"
            }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.bracket.curly.end.er"
            }
          },
          "name": "meta.embedded.expression.er",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "begin": "([a-zA-Z0-9_\\-:@.]+)\\s*(=)\\s*(\")",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "punctuation.definition.string.begin.html string.quoted.double.html"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.html string.quoted.double.html"
            }
          },
          "contentName": "string.quoted.double.html",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "([a-zA-Z0-9_\\-:@.]+)\\s*(=)\\s*(')",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "punctuation.definition.string.begin.html string.quoted.single.html"
            }
          },
          "end": "(')",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.html string.quoted.single.html"
            }
          },
          "contentName": "string.quoted.single.html",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "include": "#interpolation"
        },
        {
          "match": "([a-zA-Z0-9_\\-:@.]+)\\s*(=)\\s*([^\\s>]+)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "string.unquoted.html"
            }
          }
        },
        {
          "match": "[a-zA-Z0-9_\\-:@.]+",
          "name": "entity.other.attribute-name.html"
        }
      ]
    }
  }
}
