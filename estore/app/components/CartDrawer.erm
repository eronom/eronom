<script>
    import { cartItems, cartCount, cartSubtotal, cartTax, cartShipping, cartTotal, isCartOpen, toastMessage, orderSuccess } from "@pages/index.erm";

    useEffect(() => {
        let drawer = document.getElementById("cart-drawer");
        let backdrop = document.getElementById("cart-backdrop");
        if (isCartOpen.value) {
            if (drawer) drawer.classList.add("active");
            if (backdrop) backdrop.classList.add("active");
        } else {
            if (drawer) drawer.classList.remove("active");
            if (backdrop) backdrop.classList.remove("active");
        }
    }, [isCartOpen.value]);

    function closeCart() {
        isCartOpen.value = false;
        let drawer = document.getElementById("cart-drawer");
        let backdrop = document.getElementById("cart-backdrop");
        if (drawer) drawer.classList.remove("active");
        if (backdrop) backdrop.classList.remove("active");
    }

    function recalculate(items) {
        let count = 0;
        let subtotal = 0;
        for (let i = 0; i < items.length; i++) {
            count = count + items[i].qty;
            subtotal = subtotal + (items[i].price * items[i].qty);
        }
        cartCount.value = count;
        cartSubtotal.value = subtotal;
        let tax = Math.round(subtotal * 0.08);
        cartTax.value = tax;
        let shippingVal = (subtotal > 150 || subtotal === 0) ? 0 : 15;
        cartShipping.value = shippingVal === 0 ? "FREE" : "$" + shippingVal;
        cartTotal.value = subtotal + tax + shippingVal;
    }

    function updateQty(id, delta) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                if (current[i].id === id) {
                    let newQty = current[i].qty + delta;
                    if (newQty > 0) {
                        items.push({
                            id: current[i].id,
                            name: current[i].name,
                            price: current[i].price,
                            emoji: current[i].emoji,
                            category: current[i].category,
                            qty: newQty
                        });
                    }
                } else {
                    items.push(current[i]);
                }
            }
        }
        cartItems.value = items;
        recalculate(items);
    }

    function removeFromCart(id) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                if (current[i].id !== id) {
                    items.push(current[i]);
                }
            }
        }
        cartItems.value = items;
        recalculate(items);
    }

    function clearCart() {
        cartItems.value = [];
        recalculate([]);
    }

    function checkout() {
        if (cartCount.value === 0) return;
        orderSuccess.value = true;
        cartItems.value = [];
        recalculate([]);
        toastMessage.value = "🎉 Order placed successfully! Thank you.";
        setTimeout(() => {
            closeCart();
            orderSuccess.value = false;
        }, 3000);
    }
</script>

<!-- Cart Slide-Over Drawer -->
<div id="cart-backdrop" class="cart-backdrop" onclick={closeCart}></div>
<div id="cart-drawer" class="cart-drawer">
    <div class="cart-header">
        <div class="cart-title">
            <span>🛍️ Shopping Cart</span>
            <span class="cart-badge-count">{cartCount}</span>
        </div>
        <button class="close-btn" onclick={closeCart}>✕</button>
    </div>

    <div class="cart-items-container">
        if cartCount == 0 {
            <div class="cart-empty-state">
                <div class="empty-icon">🛒</div>
                <h3 style="color: #ffffff; margin-bottom: 8px;">Your cart is empty</h3>
                <p style="font-size: 0.9rem;">Add some high-performance gear from the store catalog to get started!</p>
            </div>
        }

        <div class="cart-items-list">
            for item in cartItems {
                <div class="cart-item-row">
                    <div class="cart-item-icon">{item.emoji}</div>
                    <div class="cart-item-details">
                        <div class="cart-item-name">{item.name}</div>
                        <div class="cart-item-price">${item.price} each</div>
                    </div>
                    <div class="qty-controls">
                        <button class="qty-btn" onclick={() => updateQty(item.id, -1)}>−</button>
                        <span class="qty-num">{item.qty}</span>
                        <button class="qty-btn" onclick={() => updateQty(item.id, 1)}>+</button>
                    </div>
                    <button class="item-del-btn" onclick={() => removeFromCart(item.id)}>✕</button>
                </div>
            }
        </div>
    </div>

    <div class="cart-footer">
        <div class="summary-line">
            <span>Subtotal</span>
            <strong style="color: #ffffff;">${cartSubtotal}</strong>
        </div>
        <div class="summary-line">
            <span>Estimated Tax (8%)</span>
            <span>${cartTax}</span>
        </div>
        <div class="summary-line">
            <span>Shipping</span>
            <span>{cartShipping}</span>
        </div>
        <div class="summary-total">
            <span>Total Due</span>
            <span style="color: #38bdf8;">${cartTotal}</span>
        </div>

        <button class="checkout-btn" onclick={checkout}>
            Complete Order &rarr;
        </button>
        <div style="text-align: center; margin-top: 12px;">
            <button style="background: none; border: none; color: #64748b; font-size: 0.8rem; cursor: pointer; text-decoration: underline;" onclick={clearCart}>
                Clear entire cart
            </button>
        </div>
    </div>
</div>

<style>
    .cart-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 200;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .cart-backdrop.active {
        opacity: 1;
        pointer-events: auto;
    }

    .cart-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        max-width: 440px;
        background: #0f111a;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        z-index: 201;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: -10px 0 50px rgba(0, 0, 0, 0.8);
    }

    .cart-drawer.active {
        transform: translateX(0);
    }

    .cart-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cart-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cart-badge-count {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 9999px;
        background: #3b82f6;
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }

    .close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .close-btn:hover {
        color: #ffffff;
    }

    .cart-items-container {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cart-item-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .cart-item-icon {
        font-size: 2rem;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .cart-item-details {
        flex: 1;
    }

    .cart-item-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #f1f5f9;
        margin-bottom: 4px;
    }

    .cart-item-price {
        font-size: 0.85rem;
        color: #94a3b8;
    }

    .qty-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 2px 6px;
    }

    .qty-btn {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        padding: 2px 6px;
    }

    .qty-btn:hover {
        color: #3b82f6;
    }

    .qty-num {
        font-size: 0.85rem;
        font-weight: 700;
        min-width: 16px;
        text-align: center;
    }

    .item-del-btn {
        background: transparent;
        border: none;
        color: #64748b;
        font-size: 1rem;
        cursor: pointer;
        margin-left: 6px;
    }

    .item-del-btn:hover {
        color: #ef4444;
    }

    .cart-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 100%;
        color: #64748b;
        padding: 40px 20px;
    }

    .empty-icon {
        font-size: 3.5rem;
        margin-bottom: 16px;
        opacity: 0.6;
    }

    .cart-footer {
        padding: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(10, 10, 15, 0.6);
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: #94a3b8;
        margin-bottom: 10px;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        font-size: 1.25rem;
        font-weight: 800;
        color: #ffffff;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px dashed rgba(255, 255, 255, 0.15);
        margin-bottom: 20px;
    }

    .checkout-btn {
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 20px rgba(16, 185, 129, 0.3);
    }

    .checkout-btn:hover {
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(16, 185, 129, 0.45);
    }
</style>
