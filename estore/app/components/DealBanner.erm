<script>
    import { isDealLoading, dealTitle, dealDiscount, dealPrice, dealOriginalPrice, dealEmoji, dealCategory } from "@pages/index.erm";

    function claimDeal() {
        if (typeof window !== "undefined" && typeof window.addToCart === "function") {
            window.addToCart(101, dealTitle.value, dealPrice.value, dealEmoji.value, dealCategory.value || "Keyboards");
        } else if (typeof addToCart === "function") {
            addToCart(101, dealTitle.value, dealPrice.value, dealEmoji.value, dealCategory.value || "Keyboards");
        }
    }

   let deal = useState(null);
  async function loadDeal() {
    const res = await fetch('/api/deal');
    deal = await res.json(); // Direct assignment (no .value)
  }
  function claimDeal() {
    // In <script>: direct access without .value!
    console.log(deal.title);
    addToCart(101, deal.title, deal.price);
  }
    
</script>

if isDealLoading {
    <div class="deal-banner-card deal-skeleton">
        <div class="deal-badge-row">
            <span class="deal-pill skeleton-glow">⚡ FLASH DEAL OF THE DAY</span>
            <span class="deal-discount skeleton-pill">Fetching deal...</span>
        </div>
        <div class="deal-content">
            <div class="deal-visual skeleton-shimmer">
                <span class="deal-emoji">⚡</span>
            </div>
            <div class="deal-info">
                <div class="skeleton-line skeleton-title-bar"></div>
                <div class="skeleton-line skeleton-desc-bar"></div>
                <div class="skeleton-pricing-row">
                    <div class="skeleton-line skeleton-price-bar"></div>
                    <div class="skeleton-line skeleton-tag-bar"></div>
                </div>
            </div>
        </div>
        <div class="deal-footer">
            <span class="deal-timer">⏳ Fetching live deal from Eronom server API...</span>
            <span class="deal-tag">API: /api/deal</span>
        </div>
    </div>
} else {
    <div class="deal-banner-card">
        <div class="deal-badge-row">
            <span class="deal-pill">⚡ FLASH DEAL OF THE DAY</span>
            <span class="deal-discount">-{dealDiscount}% OFF</span>
        </div>

        <div class="deal-content">
            <div class="deal-visual">
                <span class="deal-emoji">{dealEmoji}</span>
            </div>
            <div class="deal-info">
                <h3 class="deal-title">{dealTitle}</h3>
                <p class="deal-desc">Precision-tuned enthusiast hardware compiled with native MIR JIT speed.</p>
                <div class="deal-pricing">
                    <span class="deal-price-current">${dealPrice}</span>
                    <span class="deal-price-old">${dealOriginalPrice}</span>
                    <span class="deal-shipping-badge">✓ Free Express Delivery</span>
                </div>
            </div>
            <div class="deal-action">
                <button class="deal-claim-btn" onclick={claimDeal}>
                    Claim Flash Deal +
                </button>
            </div>
        </div>

        <div class="deal-footer">
            <span class="deal-timer">⏳ Limited inventory remaining today</span>
            <span class="deal-tag">⚡ Reactive Signal Component</span>
        </div>
    </div>
}

