        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(59, 130, 246, 0.3);
        z-index: 300;
        display: flex;
        align-items: center;
        gap: 10px;
        opacity: 0;
        transform: translateY(20px) scale(0.95);
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast-pill.active {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    /* Footer */
    .estore-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 60px 0 40px;
        background: rgba(10, 10, 15, 0.4);
        text-align: center;
    }
</style>

<div class="ambient-glow"></div>

<!-- Sticky Navbar -->
<header class="navbar">
    <div class="estore-container nav-inner">
        <div class="brand-logo">
            <div class="brand-icon">⚡</div>
            <span>estore</span>
            <Badge status="info">v1.0</Badge>
        </div>

        <div class="nav-actions">
            <button class="cart-trigger-btn" onclick={openCart}>
                <span>🛍️ Cart</span>
                <span class="cart-badge-count">{cartCount}</span>
            </button>
        </div>
    </div>
</header>

<main class="estore-container">
    <!-- Hero Banner -->
    <section class="hero-banner">
        <Badge status="info">Fine-Grained Signal Reactivity</Badge>
        <h1 class="hero-title">High-Performance Hardware<br />Engineered for Creators</h1>
        <p class="hero-subtitle">
            Experience lightning-fast e-commerce powered by Eronom, the ERM component compiler, and reactive signal state management.
        </p>

        <div class="stats-row">
            <div class="stat-pill">
                <div class="stat-dot"></div>
                <span>Zero Virtual DOM Overhead</span>
            </div>
            <div class="stat-pill">
                <div class="stat-dot"></div>
                <span>Fine-Grained Signal Stores</span>
            </div>
            <div class="stat-pill">
                <div class="stat-dot"></div>
                <span>Native uWebSockets Server</span>
            </div>
        </div>
    </section>

    <!-- Category Filter Tabs -->
    <div class="filter-bar">
        <button id="cat-btn-All" class="filter-tab active" onclick={() => setCategory("All")}>All Gear</button>
        <button id="cat-btn-Keyboards" class="filter-tab" onclick={() => setCategory("Keyboards")}>Keyboards</button>
        <button id="cat-btn-Audio" class="filter-tab" onclick={() => setCategory("Audio")}>Audio</button>
        <button id="cat-btn-Accessories" class="filter-tab" onclick={() => setCategory("Accessories")}>Accessories</button>
        <button id="cat-btn-Displays" class="filter-tab" onclick={() => setCategory("Displays")}>Displays</button>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
        <!-- Product 1: Apex Pro 75 Keyboard -->
        if activeCategory == "All" || activeCategory == "Keyboards" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Bestseller</span>
                    ⌨️
                </div>
                <div class="product-rating">★★★★★ 4.9 (142 reviews)</div>
                <h3 class="product-name">Apex Pro 75 Mechanical Keyboard</h3>
                <p class="product-desc">CNC anodized aluminum body, hot-swappable tactile switches, and doubleshot PBT keycaps with sound-dampening silicone gasket.</p>
                <div class="product-footer">
                    <span class="product-price">$189</span>
                    <button class="add-btn" onclick={() => addToCart(1, "Apex Pro 75 Keyboard", 189, "⌨️", "Keyboards")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }

        <!-- Product 2: Aura Studio ANC Headphones -->
        if activeCategory == "All" || activeCategory == "Audio" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Trending</span>
                    🎧
                </div>
                <div class="product-rating">★★★★★ 4.8 (98 reviews)</div>
                <h3 class="product-name">Aura Studio Planar Headphones</h3>
                <p class="product-desc">Planar magnetic drivers delivering lossless 24-bit audio, active noise cancellation, and up to 45 hours of ultra-low latency playback.</p>
                <div class="product-footer">
                    <span class="product-price">$299</span>
                    <button class="add-btn" onclick={() => addToCart(2, "Aura Studio Headphones", 299, "🎧", "Audio")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }

        <!-- Product 3: Precision Magnetic Mouse -->
        if activeCategory == "All" || activeCategory == "Accessories" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Popular</span>
                    🖱️
                </div>
                <div class="product-rating">★★★★★ 4.9 (84 reviews)</div>
                <h3 class="product-name">MagFlow Wireless Gaming Mouse</h3>
                <p class="product-desc">Ultra-lightweight magnesium alloy chassis, 4,000Hz polling rate, optical micro-switches, and zero-latency wireless connectivity.</p>
                <div class="product-footer">
                    <span class="product-price">$89</span>
                    <button class="add-btn" onclick={() => addToCart(3, "MagFlow Wireless Mouse", 89, "🖱️", "Accessories")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }

        <!-- Product 4: Ultrawide QD-OLED Monitor -->
        if activeCategory == "All" || activeCategory == "Displays" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Flagship</span>
                    🖥️
                </div>
                <div class="product-rating">★★★★★ 5.0 (61 reviews)</div>
                <h3 class="product-name">Ultrawide 34-Inch QD-OLED Display</h3>
                <p class="product-desc">1800R curved quantum dot OLED panel, 175Hz refresh rate, 0.03ms pixel response time, and 99.3% DCI-P3 cinematic color gamut.</p>
                <div class="product-footer">
                    <span class="product-price">$799</span>
                    <button class="add-btn" onclick={() => addToCart(4, "34-Inch QD-OLED Display", 799, "🖥️", "Displays")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }

        <!-- Product 5: Dark Grid Deskmat -->
        if activeCategory == "All" || activeCategory == "Accessories" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Essential</span>
                    ⚡
                </div>
                <div class="product-rating">★★★★★ 4.9 (218 reviews)</div>
                <h3 class="product-name">Eronom Stealth Deskmat</h3>
                <p class="product-desc">900x400mm waterproof textured microfiber surface with anti-fray stitched perimeter and anti-slip natural rubber foundation.</p>
                <div class="product-footer">
                    <span class="product-price">$35</span>
                    <button class="add-btn" onclick={() => addToCart(5, "Eronom Stealth Deskmat", 35, "⚡", "Accessories")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }

        <!-- Product 6: Audiophile Dual DAC -->
        if activeCategory == "All" || activeCategory == "Audio" {
            <div class="product-card-wrap">
                <div class="product-visual">
                    <span class="product-badge-tag">Hi-Res</span>
                    🎚️
                </div>
                <div class="product-rating">★★★★★ 4.9 (73 reviews)</div>
                <h3 class="product-name">AeroDAC Hi-Res Audio Decoder</h3>
                <p class="product-desc">Dual flagship DAC architecture supporting 32-bit/384kHz PCM & DSD256 decoding with 4.4mm balanced and 3.5mm headphone jacks.</p>
                <div class="product-footer">
                    <span class="product-price">$129</span>
                    <button class="add-btn" onclick={() => addToCart(6, "AeroDAC Audio Decoder", 129, "🎚️", "Audio")}>
                        Add to Cart +
                    </button>
                </div>
            </div>
        }
    </div>
</main>

<!-- Cart Slide-Over Drawer -->
<div id="cart-backdrop" class="cart-backdrop" onclick={closeCart}></div>
<div id="cart-drawer" class="cart-drawer">
    <div class="cart-header">
        <div class="cart-title">
            <span>🛍️ Shopping Cart</span>
            <span class="cart-badge-count">{cartCount}</span>
        </div>
        <button class="close-btn" onclick={closeCart}>✕</button>
    </div>

    <div class="cart-items-container">
        if cartCount == 0 {
            <div class="cart-empty-state">
                <div class="empty-icon">🛒</div>
                <h3 style="color: #ffffff; margin-bottom: 8px;">Your cart is empty</h3>
                <p style="font-size: 0.9rem;">Add some high-performance gear from the store catalog to get started!</p>
            </div>
        }

        <div class="cart-items-list">
            for item in cartItems {
                <div class="cart-item-row">
                    <div class="cart-item-icon">{item.emoji}</div>
                    <div class="cart-item-details">
                        <div class="cart-item-name">{item.name}</div>
                        <div class="cart-item-price">${item.price} each</div>
                    </div>
                    <div class="qty-controls">
                        <button class="qty-btn" onclick={() => updateQty(item.id, -1)}>−</button>
                        <span class="qty-num">{item.qty}</span>
                        <button class="qty-btn" onclick={() => updateQty(item.id, 1)}>+</button>
                    </div>
                    <button class="item-del-btn" onclick={() => removeFromCart(item.id)}>✕</button>
                </div>
            }
        </div>
    </div>

    <div class="cart-footer">
        <div class="summary-line">
            <span>Subtotal</span>
            <strong style="color: #ffffff;">${cartSubtotal}</strong>
        </div>
        <div class="summary-line">
            <span>Estimated Tax (8%)</span>
            <span>${cartTax}</span>
        </div>
        <div class="summary-line">
            <span>Shipping</span>
            <span>{cartShipping}</span>
        </div>
        <div class="summary-total">
            <span>Total Due</span>
            <span style="color: #38bdf8;">${cartTotal}</span>
        </div>

        <button class="checkout-btn" onclick={checkout}>
            Complete Order &rarr;
        </button>
        <div style="text-align: center; margin-top: 12px;">
            <button style="background: none; border: none; color: #64748b; font-size: 0.8rem; cursor: pointer; text-decoration: underline;" onclick={clearCart}>
                Clear entire cart
            </button>
        </div>
    </div>
</div>

<!-- Floating Toast Notification -->
<div id="toast-pill" class="toast-pill">
    <span>⚡</span>
    <span>{toastMessage}</span>
</div>

<!-- Footer -->
<footer class="estore-footer">
    <div class="estore-container">
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 8px;">
            estore ⚡ An Eronom Reactive Component Framework Demonstration
        </p>
        <p style="color: #475569; font-size: 0.8rem;">
            Built with fine-grained signals, EDS design system, and connection-preserving HMR.
        </p>
    </div>
</footer>
