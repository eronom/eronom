<script>
    // --- Reactive State Management ---
    let cartItems = useState([]);
    let cartCount = useState(0);
    let cartSubtotal = useState(0);
    let cartTax = useState(0);
    let cartShipping = useState("FREE");
    let cartTotal = useState(0);
    
    let isCartOpen = useState(false);
    let activeCategory = useState("All");
    let toastMessage = useState("");
    let orderSuccess = useState(false);

    function recalculate(items) {
        let count = 0;
        let subtotal = 0;
        for (let i = 0; i < items.length; i++) {
            count = count + items[i].qty;
            subtotal = subtotal + (items[i].price * items[i].qty);
        }
        cartCount.value = count;
        cartSubtotal.value = subtotal;
        let tax = Math.round(subtotal * 0.08);
        cartTax.value = tax;
        let shippingVal = (subtotal > 150 || subtotal === 0) ? 0 : 15;
        cartShipping.value = shippingVal === 0 ? "FREE" : "$" + shippingVal;
        cartTotal.value = subtotal + tax + shippingVal;
    }

    function addToCart(id, name, price, emoji, category) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                items.push({
                    id: current[i].id,
                    name: current[i].name,
                    price: current[i].price,
                    emoji: current[i].emoji,
                    category: current[i].category,
                    qty: current[i].qty
                });
            }
        }
        let found = false;
        for (let i = 0; i < items.length; i++) {
            if (items[i].id === id) {
                items[i].qty = items[i].qty + 1;
                found = true;
                break;
            }
        }
        if (!found) {
            items.push({ id: id, name: name, price: price, emoji: emoji, category: category, qty: 1 });
        }
        cartItems.value = items;
        recalculate(items);

        toastMessage.value = "Added " + name + " to cart!";
        let toast = document.getElementById("toast-pill");
        if (toast) {
            toast.classList.add("active");
            setTimeout(() => {
                if (toastMessage.value.indexOf(name) !== -1) {
                    toast.classList.remove("active");
                }
            }, 3000);
        }
    }

    function updateQty(id, delta) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                if (current[i].id === id) {
                    let newQty = current[i].qty + delta;
                    if (newQty > 0) {
                        items.push({
                            id: current[i].id,
                            name: current[i].name,
                            price: current[i].price,
                            emoji: current[i].emoji,
                            category: current[i].category,
                            qty: newQty
                        });
                    }
                } else {
                    items.push(current[i]);
                }
            }
        }
        cartItems.value = items;
        recalculate(items);
    }

    function removeFromCart(id) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                if (current[i].id !== id) {
                    items.push(current[i]);
                }
            }
        }
        cartItems.value = items;
        recalculate(items);
    }

    function clearCart() {
        cartItems.value = [];
        recalculate([]);
    }

    function openCart() {
        isCartOpen.value = true;
        let drawer = document.getElementById("cart-drawer");
        let backdrop = document.getElementById("cart-backdrop");
        if (drawer) drawer.classList.add("active");
        if (backdrop) backdrop.classList.add("active");
    }

    function closeCart() {
        isCartOpen.value = false;
        let drawer = document.getElementById("cart-drawer");
        let backdrop = document.getElementById("cart-backdrop");
        if (drawer) drawer.classList.remove("active");
        if (backdrop) backdrop.classList.remove("active");
    }

    function checkout() {
        if (cartCount.value === 0) return;
        orderSuccess.value = true;
        cartItems.value = [];
        recalculate([]);
        toastMessage.value = "🎉 Order placed successfully! Thank you.";
        let toast = document.getElementById("toast-pill");
        if (toast) toast.classList.add("active");
        setTimeout(() => {
            closeCart();
            orderSuccess.value = false;
            if (toast) toast.classList.remove("active");
            toastMessage.value = "";
        }, 3000);
    }

    function setCategory(cat) {
        activeCategory.value = cat;
        const cats = ["All", "Keyboards", "Audio", "Accessories", "Displays"];
        for (let i = 0; i < cats.length; i++) {
            let btn = document.getElementById("cat-btn-" + cats[i]);
            if (btn) {
                if (cats[i] === cat) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            }
        }
    }
</script>

<style>
    /* Estore Custom Luxury Styling */
    .estore-container {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* Ambient Background Glow */
    .ambient-glow {
        position: fixed;
        top: -150px;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 450px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, rgba(99, 102, 241, 0.05) 50%, transparent 80%);
        pointer-events: none;
        z-index: 0;
    }

    /* Glass Navbar */
    .navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        background: rgba(10, 10, 15, 0.75);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 16px 0;
    }

    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #ffffff;
    }

    .brand-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .cart-trigger-btn {
        position: relative;
        display: flex;
