<script>
    // --- Reactive State Management (Exported for Component Sharing) ---
    export let cartItems = useState([]);
    export let cartCount = useState(0);
    export let cartSubtotal = useState(0);
    export let cartTax = useState(0);
    export let cartShipping = useState("FREE");
    export let cartTotal = useState(0);
    
    export let isCartOpen = useState(false);
    export let activeCategory = useState("All");
    export let toastMessage = useState("");
    export let orderSuccess = useState(false);

    function recalculate(items) {
        let count = 0;
        let subtotal = 0;
        for (let i = 0; i < items.length; i++) {
            count = count + items[i].qty;
            subtotal = subtotal + (items[i].price * items[i].qty);
        }
        cartCount.value = count;
        cartSubtotal.value = subtotal;
        let tax = Math.round(subtotal * 0.08);
        cartTax.value = tax;
        let shippingVal = (subtotal > 150 || subtotal === 0) ? 0 : 15;
        cartShipping.value = shippingVal === 0 ? "FREE" : "$" + shippingVal;
        cartTotal.value = subtotal + tax + shippingVal;
    }

    function addToCart(id, name, price, emoji, category) {
        let current = cartItems.value;
        let items = [];
        if (current && current.length) {
            for (let i = 0; i < current.length; i++) {
                items.push({
                    id: current[i].id,
                    name: current[i].name,
                    price: current[i].price,
                    emoji: current[i].emoji,
                    category: current[i].category,
                    qty: current[i].qty
                });
            }
        }
        let found = false;
        for (let i = 0; i < items.length; i++) {
            if (items[i].id === id) {
                items[i].qty = items[i].qty + 1;
                found = true;
                break;
            }
        }
        if (!found) {
            items.push({ id: id, name: name, price: price, emoji: emoji, category: category, qty: 1 });
        }
        cartItems.value = items;
        recalculate(items);
        toastMessage.value = "Added " + name + " to cart!";
    }

    function openCart() {
        isCartOpen.value = true;
    }

    function closeCart() {
        isCartOpen.value = false;
    }

    function setCategory(cat) {
        activeCategory.value = cat;
        const cats = ["All", "Keyboards", "Audio", "Accessories", "Displays"];
        for (let i = 0; i < cats.length; i++) {
            let btn = document.getElementById("cat-btn-" + cats[i]);
            if (btn) {
                if (cats[i] === cat) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            }
        }
    }

    useEffect(() => {
        fetch("/api/deal")
            .then(async (res) => {
                if (!res.ok) {
                    let detail = await res.text();
                    throw new Error("HTTP " + res.status + (detail ? ": " + detail : ""));
                }
                return res.text();
            })
            .then((html) => {
                let slot = document.getElementById("server-deal-slot");
                if (slot && html) {
                    slot.innerHTML = html;
                    slot.querySelectorAll("script").forEach((oldScript) => {
                        let newScript = document.createElement("script");
                        Array.from(oldScript.attributes).forEach((attr) => newScript.setAttribute(attr.name, attr.value));
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }
            })
            .catch((err) => console.error("Server deal fetch error:", err));
    }, []);
</script>

