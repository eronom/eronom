// Standard Environment library for Eronom

export const get = Eronom_nativeEnvGet
export const set = Eronom_nativeEnvSet
export const has = Eronom_nativeEnvHas
export const remove = Eronom_nativeEnvRemove
export const all = Eronom_nativeEnvAll

export const env = {
  get: get,
  set: set,
  has: has,
  remove: remove,
  all: all
}
