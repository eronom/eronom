// Standard I/O library for Eronom

const callWithArity = (func, args) => {
  const length = arrayLen(args)
  if (length == 0) { return func() }
  if (length == 1) { return func(args[0]) }
  if (length == 2) { return func(args[0], args[1]) }
  if (length == 3) { return func(args[0], args[1], args[2]) }
  if (length == 4) { return func(args[0], args[1], args[2], args[3]) }
  if (length == 5) { return func(args[0], args[1], args[2], args[3], args[4]) }
  return func()
}

export const Io = {
  setMode: (mode) => {
    setIoMode(mode)
  },
  getMode: () => {
    return getIoMode()
  },
  spawn: (func, args) => {
    return spawnTask(func, args)
  },
  wait: (future) => {
    return futureAwait(future)
  }
}

export struct File {
  name: string,
  type: string,
  size: int,
  
  fn exists() {
    return Eronom_nativeFileExists(this.name)
  }
  fn text() {
    return Eronom_nativeFileText(this.name)
  }
  fn json() {
    return Eronom_nativeFileJson(this.name)
  }
}

export const file = (path) => {
  return File({
    name: path,
    type: Eronom_nativeGetMimeType(path),
    size: Eronom_nativeGetFileSize(path)
  })
}

export const write = (path, data) => {
  let is_file = Eronom_nativeIsFile(data)
  let dataStr = data
  if (is_file) {
    dataStr = data.name
  }
  return Eronom_nativeWriteFile(path, dataStr, is_file)
}
