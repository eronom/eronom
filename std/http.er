// Standard HTTP library for Eronom

// Native serve primitive (also available globally)
export const serve = serve

// HTTP Status Codes mapping
export const status = {
  OK: 200,
  CREATED: 201,
  ACCEPTED: 202,
  NO_CONTENT: 204,
  PARTIAL_CONTENT: 206,
  MOVED_PERMANENTLY: 301,
  FOUND: 302,
  SEE_OTHER: 303,
  NOT_MODIFIED: 304,
  TEMPORARY_REDIRECT: 307,
  PERMANENT_REDIRECT: 308,
  BAD_REQUEST: 400,
  UNAUTHORIZED: 401,
  FORBIDDEN: 403,
  NOT_FOUND: 404,
  METHOD_NOT_ALLOWED: 405,
  CONFLICT: 409,
  RANGE_NOT_SATISFIABLE: 416,
  TOO_MANY_REQUESTS: 429,
  INTERNAL_SERVER_ERROR: 500,
  BAD_GATEWAY: 502,
  SERVICE_UNAVAILABLE: 503
}

// Web-Standard-like Response object helper
export const Response = {
  json: (data, init) => {
    let s = 200
    let h = { "content-type": "application/json" }
    if (init && init.status) {
      s = init.status
    }
    if (init && init.headers) {
      for (let k in init.headers) {
        h[k] = init.headers[k]
      }
    }
    return {
      _isResponse: true,
      status: s,
      headers: h,
      body: JSON.stringify(data)
    }
  },
  text: (data, init) => {
    let s = 200
    let h = { "content-type": "text/plain; charset=utf-8" }
    if (init && init.status) {
      s = init.status
    }
    if (init && init.headers) {
      for (let k in init.headers) {
        h[k] = init.headers[k]
      }
    }
    return {
      _isResponse: true,
      status: s,
      headers: h,
      body: String(data)
    }
  },
  html: (data, init) => {
    let s = 200
    let h = { "content-type": "text/html; charset=utf-8" }
    if (init && init.status) {
      s = init.status
    }
    if (init && init.headers) {
      for (let k in init.headers) {
        h[k] = init.headers[k]
      }
    }
    return {
      _isResponse: true,
      status: s,
      headers: h,
      body: String(data)
    }
  },
  redirect: (url, s) => {
    let st = 302
    if (s) {
      st = s
    }
    return {
      _isResponse: true,
      status: st,
      headers: { "location": url },
      body: ""
    }
  }
}

// Helper: match route pattern against clean path
const matchPath = (pattern, path) => {
  if (pattern == path || pattern == "/*") {
    return {}
  }
  
  if (pattern.endsWith("/*")) {
    let prefix = pattern.slice(0, pattern.length - 2)
    if (path.startsWith(prefix)) {
      return {}
    }
  }

  let patParts = pattern.split("/")
  let pathParts = path.split("/")

  if (patParts.length != pathParts.length) {
    return null
  }

  let params = {}
  for (i in 0..patParts.length) {
    let p = patParts[i]
    let seg = pathParts[i]
    if (p.startsWith(":")) {
      let paramName = p.slice(1)
      params[paramName] = seg
    } else if (p == "*") {
      // wildcard matches any single segment
    } else if (p != seg) {
      return null
    }
  }

  return params
}

// Script-level Router built on top of native serve()
export const router = () => {
  let routes = []
  let middlewares = []
  let staticMounts = []
  let wsConfig = null
  let serverInstance = null

  let addRoute = (method, path, handler) => {
    routes.push({ method: method, path: path, handler: handler })
  }

  let app = {
    get: (path, handler) => { addRoute("GET", path, handler); return app },
    post: (path, handler) => { addRoute("POST", path, handler); return app },
    put: (path, handler) => { addRoute("PUT", path, handler); return app },
    delete: (path, handler) => { addRoute("DELETE", path, handler); return app },
    del: (path, handler) => { addRoute("DELETE", path, handler); return app },
    patch: (path, handler) => { addRoute("PATCH", path, handler); return app },
    head: (path, handler) => { addRoute("HEAD", path, handler); return app },
    options: (path, handler) => { addRoute("OPTIONS", path, handler); return app },
    all: (path, handler) => { addRoute("ALL", path, handler); return app },
    any: (path, handler) => { addRoute("ALL", path, handler); return app },

    use: (arg1, arg2) => {
      if (typeof arg1 == "function") {
        middlewares.push(arg1)
      } else if (typeof arg1 == "string" && typeof arg2 == "function") {
        let prefix = arg1
        let mw = arg2
        middlewares.push((c) => {
          if (c.req.path.startsWith(prefix)) {
            return mw(c)
          }
        })
      }
      return app
    },

    static: (prefix, dir) => {
      staticMounts.push({ prefix: prefix, dir: dir })
      return app
    },
    serveStatic: (prefix, dir) => {
      staticMounts.push({ prefix: prefix, dir: dir })
      return app
    },

    ws: (path, handlers) => {
      wsConfig = handlers
      return app
    },

    publish: (topic, message) => {
      if (serverInstance && serverInstance.publish) {
        return serverInstance.publish(topic, message)
      }
    },

    numSubscribers: (topic) => {
      if (serverInstance && serverInstance.numSubscribers) {
        return serverInstance.numSubscribers(topic)
      }
      return 0
    },

    fetch: (c, srv) => {
      let currentStatus = 200
      c.status = (code) => {
        if (code) {
          currentStatus = code
        }
        return currentStatus
      }
      c.json = (data, st) => {
        let s = currentStatus
        if (st) {
          s = st
        }
        return Response.json(data, { status: s })
      }
      c.text = (data, st) => {
        let s = currentStatus
        if (st) {
          s = st
        }
        return Response.text(data, { status: s })
      }
      c.html = (data, st) => {
        let s = currentStatus
        if (st) {
          s = st
        }
        return Response.html(data, { status: s })
      }
      c.redirect = (url, st) => {
        return Response.redirect(url, st)
      }

      // 1. Run global middlewares
      for (mw in middlewares) {
        let res = mw(c)
        if (res != null) {
          return res
        }
      }

      let reqMethod = c.req.method
      let reqPath = c.req.path

      // 2. Check registered routes
      for (r in routes) {
        if (r.method == "ALL" || r.method == reqMethod) {
          let matchedParams = matchPath(r.path, reqPath)
          if (matchedParams != null) {
            c.params = matchedParams
            c.req.params = matchedParams
            return r.handler(c)
          }
        }
      }

      // 3. Check static mounts
      for (sm in staticMounts) {
        if (reqPath.startsWith(sm.prefix)) {
          let rel = reqPath.slice(sm.prefix.length)
          if (rel.startsWith("/")) {
            rel = rel.slice(1)
          }
          let filePath = sm.dir + "/" + rel
          return c.file(filePath)
        }
      }

      // 4. Default 404
      c.status(404)
      return c.json({ error: "Not Found", path: reqPath })
    },

    listen: (port, callback) => {
      let p = port || 3000
      serverInstance = serve({
        port: p,
        fetch: (c, srv) => {
          return app.fetch(c, srv)
        },
        websocket: wsConfig
      })

      if (callback) {
        callback()
      }

      return serverInstance
    }
  }

  return app
}

// Standard createServer API
export const createServer = (handler) => {
  let app = router()
  app.all("/*", (c) => {
    let req = {
      url: c.req.url,
      path: c.req.path,
      method: c.req.method,
      params: c.req.params,
      query: c.req.query,
      rawQuery: c.req.rawQuery,
      headers: c.req.headers,
      cookies: c.req.cookies,
      header: (name) => c.req.header(name),
      cookie: (name) => c.req.cookie(name)
    }
    let res = {
      statusCode: 200,
      headers: {},
      setHeader: (name, val) => { c.res.setHeader(name, val) },
      writeHead: (statusCode) => { c.res.status(statusCode) },
      status: (code) => { c.res.status(code); return res },
      json: (data, code) => { c.res.json(data, code) },
      html: (data, code) => { c.res.html(data, code) },
      send: (data, code) => { c.res.send(data, code) },
      end: (data) => { c.res.end(data) }
    }
    return handler(req, res)
  })

  return {
    listen: (port, callback) => {
      return app.listen(port, callback)
    }
  }
}
