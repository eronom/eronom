// Eronom Reactive Modules (ERM) - CLI Dev Server Runner
import { createDevServer } from "std/erm/dev.er"
import { exists } from "std/fs.er"

let pagesDir = "app/pages"
if (!exists(pagesDir) && exists("pages")) {
  pagesDir = "pages"
}

let devServer = createDevServer({
  pagesDir: pagesDir,
  isProd: false
})

print("⚡ Eronom ERM Development Server running")

devServer.listen(3000)

