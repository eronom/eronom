// Eronom Reactive Modules (ERM) - File-System Router & Parameter Matcher
// Written in native Eronom script (.er)

import { exists, stat, readDir } from "std/fs.er"
import { join, resolve, dirname, basename, extname } from "std/path.er"

// Helper: Normalize URL path into clean non-empty segment array
export const splitPath = (urlPath) => {
  if (!urlPath) {
    return []
  }
  // Strip query string and hash if present
  let clean = urlPath
  let qIdx = clean.indexOf("?")
  if (qIdx != -1) {
    clean = clean.slice(0, qIdx)
  }
  let hIdx = clean.indexOf("#")
  if (hIdx != -1) {
    clean = clean.slice(0, hIdx)
  }

  let rawParts = clean.split("/")
  let parts = []
  for p in rawParts {
    let trimmed = p.trim()
    if (trimmed.length > 0) {
      parts.push(trimmed)
    }
  }
  return parts
}

// Helper: Check if file or directory exists and retrieve stats
export const checkStat = (path) => {
  if (!exists(path)) {
    return null
  }
  return stat(path)
}

// Find all layout.erm files from baseDir down to targetDir (outermost to innermost)
export const findLayoutChain = (baseDir, targetDir) => {
  let curr = resolve(targetDir)
  let root = resolve(baseDir)

  // Walk up from targetDir to baseDir
  let chain = []
  let reachedRoot = false

  while (!reachedRoot) {
    // Check direct layout.erm
    let directLayout = join(curr, "layout.erm")
    if (exists(directLayout)) {
      chain.push(directLayout)
    } else {
      // Check layouts/layout.erm
      let subLayout = join(curr, "layouts/layout.erm")
      if (exists(subLayout)) {
        chain.push(subLayout)
      }
    }

    if (curr == root || curr == "/" || curr == "." || curr.length <= root.length) {
      reachedRoot = true
    } else {
      let parent = dirname(curr)
      if (parent == curr) {
        reachedRoot = true
      } else {
        curr = parent
      }
    }
  }

  // Reverse so outermost layout comes first, innermost comes last
  let layouts = []
  let count = chain.length
  let idx = count - 1
  while (idx >= 0) {
    layouts.push(chain[idx])
    idx = idx - 1
  }
  return layouts
}

// Extract parameter name from dynamic bracket format: "[id]" -> "id"
export const extractParamName = (token) => {
  if (token.startsWith("[") && token.endsWith("]")) {
    return token.slice(1, token.length - 1)
  }
  return null
}

// Resolve a target URL path against a base pages directory
export const resolveRoute = (baseDir, targetPath) => {
  let parts = splitPath(targetPath)
  let currentPath = resolve(baseDir)
  let params = {}
  let routeSegments = []

  // Handle root route "/"
  if (parts.length == 0) {
    let rootCandidates = ["index.erm", "index.er", "index.html", "page.erm"]
    for candName in rootCandidates {
      let cand = join(currentPath, candName)
      if (exists(cand)) {
        return {
          matched: true,
          filePath: cand,
          routePattern: "/",
          params: params,
          isApi: cand.endsWith(".er"),
          layouts: findLayoutChain(baseDir, currentPath)
        }
      }
    }
    return null
  }

  let i = 0
  while (i < parts.length) {
    let part = parts[i]
    let isLast = i == parts.length - 1
    let found = false

    // 1. Direct directory match (if not last)
    if (!isLast) {
      let directDir = join(currentPath, part)
      let s = checkStat(directDir)
      if (s && s.isDirectory) {
        currentPath = directDir
        routeSegments.push(part)
        found = true
        i = i + 1
        continue
      }
    }

    // 2. Exact file matches for last segment
    if (isLast) {
      let exactErm = join(currentPath, part + ".erm")
      if (exists(exactErm)) {
        routeSegments.push(part)
        return {
          matched: true,
          filePath: exactErm,
          routePattern: "/" + routeSegments.join("/"),
          params: params,
          isApi: false,
          layouts: findLayoutChain(baseDir, currentPath)
        }
      }

      let exactEr = join(currentPath, part + ".er")
      if (exists(exactEr)) {
        routeSegments.push(part)
        return {
          matched: true,
          filePath: exactEr,
          routePattern: "/" + routeSegments.join("/"),
          params: params,
          isApi: true,
          layouts: findLayoutChain(baseDir, currentPath)
        }
      }

      let exactHtml = join(currentPath, part + ".html")
      if (exists(exactHtml)) {
        routeSegments.push(part)
        return {
          matched: true,
          filePath: exactHtml,
          routePattern: "/" + routeSegments.join("/"),
          params: params,
          isApi: false,
          layouts: findLayoutChain(baseDir, currentPath)
        }
      }

      // Check if part is a directory containing index.erm
      let subDir = join(currentPath, part)
      let s = checkStat(subDir)
      if (s && s.isDirectory) {
        let indexCandidates = ["index.erm", "index.er", "index.html"]
        for idxName in indexCandidates {
          let idxFile = join(subDir, idxName)
          if (exists(idxFile)) {
            routeSegments.push(part)
            return {
              matched: true,
              filePath: idxFile,
              routePattern: "/" + routeSegments.join("/"),
              params: params,
              isApi: idxFile.endsWith(".er"),
              layouts: findLayoutChain(baseDir, subDir)
            }
          }
        }
      }
    }

    // 3. Scan directory entries for dynamic parameter segments: [id], [...slug]
    let entries = readDir(currentPath)
    if (entries) {
      // First check single parameter dynamic matches: [id].erm or [id]
      for entry in entries {
        let entryName = typeof entry == "string" ? entry : entry.name

        if (entryName.startsWith("[") && !entryName.startsWith("[...")) {
          // Dynamic file match: [id].erm, [id].er, [id].html
          if (isLast) {
            let ext = extname(entryName)
            if (ext == ".erm" || ext == ".er" || ext == ".html") {
              let rawName = entryName.slice(0, entryName.length - ext.length)
              let paramName = extractParamName(rawName)
              if (paramName) {
                params[paramName] = part
                routeSegments.push(":" + paramName)
                let matchedFile = join(currentPath, entryName)
                return {
                  matched: true,
                  filePath: matchedFile,
                  routePattern: "/" + routeSegments.join("/"),
                  params: params,
                  isApi: ext == ".er",
                  layouts: findLayoutChain(baseDir, currentPath)
                }
              }
            }
          }

          // Dynamic directory match: [id]/...
          let rawDirName = extractParamName(entryName)
          if (rawDirName) {
            let dynDirPath = join(currentPath, entryName)
            let st = checkStat(dynDirPath)
            if (st && st.isDirectory) {
              params[rawDirName] = part
              routeSegments.push(":" + rawDirName)
              currentPath = dynDirPath
              found = true
              break
            }
          }
        }
      }

      if (found) {
        i = i + 1
        continue
      }

      // Check catch-all wildcard matches: [...slug]
      for entry in entries {
        let entryName = typeof entry == "string" ? entry : entry.name

        if (entryName.startsWith("[...")) {
          let ext = extname(entryName)
          let raw = ext ? entryName.slice(0, entryName.length - ext.length) : entryName
          if (raw.endsWith("]")) {
            let slugName = raw.slice(4, raw.length - 1)
            let restParts = parts.slice(i)
            params[slugName] = restParts.join("/")
            routeSegments.push("*" + slugName)
            let matchedPath = join(currentPath, entryName)

            // If it's a directory, check for index.erm inside
            let st = checkStat(matchedPath)
            if (st && st.isDirectory) {
              let idxFile = join(matchedPath, "index.erm")
              if (exists(idxFile)) {
                matchedPath = idxFile
              }
            }

            return {
              matched: true,
              filePath: matchedPath,
              routePattern: "/" + routeSegments.join("/"),
              params: params,
              isApi: matchedPath.endsWith(".er"),
              layouts: findLayoutChain(baseDir, currentPath)
            }
          }
        }
      }
    }

    if (!found) {
      return null
    }

    i = i + 1
  }

  return null
}

// Recursively scan all routes in a directory and return a route table
export const scanRoutes = (baseDir, subDir, list) => {
  let routesList = list || []
  let currentDir = subDir ? join(baseDir, subDir) : baseDir
  let entries = readDir(currentDir)

  if (!entries) {
    return routesList
  }

  for entry in entries {
    let name = typeof entry == "string" ? entry : entry.name

    // Ignore hidden files and development build directories
    if (name.startsWith(".") || name == "target" || name == "build" || name == "node_modules") {
      continue
    }

    let fullPath = join(currentDir, name)
    let s = checkStat(fullPath)
    if (!s) {
      continue
    }

    if (s.isDirectory) {
      let nextSub = subDir ? join(subDir, name) : name
      scanRoutes(baseDir, nextSub, routesList)
    } else if (s.isFile) {
      let ext = extname(name)
      if (ext == ".erm" || ext == ".er" || ext == ".html") {
        if (name == "layout.erm" || name == "layout.html") {
          continue
        }

        let baseName = name.slice(0, name.length - ext.length)
        let routeSegments = []
        if (subDir) {
          let sParts = splitPath(subDir)
          for seg in sParts {
            let pName = extractParamName(seg)
            if (pName) {
              routeSegments.push(":" + pName)
            } else {
              routeSegments.push(seg)
            }
          }
        }

        if (baseName != "index" && baseName != "page") {
          let pName = extractParamName(baseName)
          if (pName) {
            routeSegments.push(":" + pName)
          } else {
            routeSegments.push(baseName)
          }
        }

        let pattern = "/" + routeSegments.join("/")
        routesList.push({
          pattern: pattern,
          filePath: fullPath,
          isApi: ext == ".er",
          layouts: findLayoutChain(baseDir, currentDir)
        })
      }
    }
  }

  return routesList
}

// Router factory returning an Eronom router instance
export const createFileSystemRouter = (pagesDir) => {
  let rootDir = resolve(pagesDir || "app/pages")

  return {
    baseDir: rootDir,
    resolve: (urlPath) => resolveRoute(rootDir, urlPath),
    routes: () => scanRoutes(rootDir),
    match: (reqOrPath) => {
      let pathStr = typeof reqOrPath == "string" ? reqOrPath : (reqOrPath ? reqOrPath.path || "/" : "/")
      return resolveRoute(rootDir, pathStr)
    }
  }
}

export const Router = {
  create: createFileSystemRouter,
  resolve: resolveRoute,
  scan: scanRoutes,
  splitPath: splitPath,
  findLayouts: findLayoutChain
}
