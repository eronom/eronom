// Eronom Reactive Modules (ERM) - Native Render Primitives
// Written in native Eronom script (.er)

export const render = (filePath, params, isProd) => {
  let p = params || {}
  let prod = isProd == null ? true : isProd
  if (typeof Eronom_nativeRender == "function") {
    return Eronom_nativeRender(filePath, p, prod)
  }
  if (typeof render == "function") {
    return render(filePath, p, prod)
  }
  return ""
}

export const renderString = (templateString, params, isProd) => {
  let p = params || {}
  let prod = isProd == null ? true : isProd
  if (typeof Eronom_nativeRenderString == "function") {
    return Eronom_nativeRenderString(templateString, p, prod)
  }
  if (typeof renderString == "function") {
    return renderString(templateString, p, prod)
  }
  return ""
}

export const compile = render
export const compileString = renderString
