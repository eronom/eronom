// Eronom Reactive Modules (ERM) - Development Server Watcher & HMR Broker
// Written in native Eronom script (.er)

import { stat, readDir } from "std/fs.er"
import { join, resolve } from "std/path.er"
import { createServer } from "std/erm/server.er"

// Creates a snapshot map of all file modification timestamps in a directory
export const createSnapshot = (dirPath, targetMap) => {
  let fileMap = targetMap || {}
  let entries = readDir(dirPath)

  if (!entries) {
    return fileMap
  }

  for entry in entries {
    let name = typeof entry == "string" ? entry : entry.name

    if (name.startsWith(".") || name == "target" || name == "build" || name == "node_modules") {
      continue
    }

    let fullPath = join(dirPath, name)
    let s = stat(fullPath)
    if (!s) {
      continue
    }

    if (s.isDirectory) {
      createSnapshot(fullPath, fileMap)
    } else if (s.isFile) {
      fileMap[fullPath] = s.mtime || 1
    }
  }

  return fileMap
}

// Diffs two file snapshots and returns list of modified, added, or removed files
export const diffSnapshots = (oldSnap, newSnap) => {
  let changes = []

  // Check modified or added
  for path in newSnap {
    let newTime = newSnap[path]
    let oldTime = oldSnap[path]

    if (oldTime == null) {
      changes.push({
        type: "add",
        path: path
      })
    } else if (newTime != oldTime) {
      changes.push({
        type: "change",
        path: path
      })
    }
  }

  // Check removed
  for path in oldSnap {
    if (newSnap[path] == null) {
      changes.push({
        type: "unlink",
        path: path
      })
    }
  }

  return changes
}

// Builds JSON WebSocket message payload for Hot Module Reloading
export const buildHmrPayload = (changeType, filePath) => {
  let t = changeType || "update"
  let p = filePath || ""

  return "\{\"type\":\"" + t + "\",\"path\":\"" + p + "\"\}"
}

// Development server coordinator wrapping SSR handler and live change tracking
export const createDevServer = (options) => {
  let opts = options || {}
  let watchDir = resolve(opts.watchDir || opts.pagesDir || "app/pages")
  let app = createServer(opts)

  let snapshot = createSnapshot(watchDir)
  let clients = []

  return {
    app: app,
    handle: (req) => app.handle(req),
    getSnapshot: () => snapshot,
    // Polls or checks for file changes and notifies clients
    checkChanges: () => {
      let currentSnap = createSnapshot(watchDir)
      let changes = diffSnapshots(snapshot, currentSnap)
      if (changes.length > 0) {
        snapshot = currentSnap
      }
      return changes
    },
    buildPayload: buildHmrPayload,
    listen: (port, callback) => {
      let p = port || 3000
      return app.listen(p, callback)
    }
  }
}

export const Dev = {
  createSnapshot: createSnapshot,
  diffSnapshots: diffSnapshots,
  buildHmrPayload: buildHmrPayload,
  createDevServer: createDevServer
}
