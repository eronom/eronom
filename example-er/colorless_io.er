import { Io } from "std/io"

// Colorless async/sync fetch routine (uses global fetch, completely signature-agnostic of I/O mode)
const getTodoColorless = (url) => {
  print("[Colorless] Fetching URL: " + url)
  const response = fetch(url) // <-- Just a standard global fetch call
  print("[Colorless] Decode response...")
  const todo = response.json()
  print("[Colorless] Decoded Todo:")
  print(todo)
  return todo
}

print("=== Running in Threaded (Blocking) Mode ===")
Io.setMode("threaded")
const todo1 = getTodoColorless("https://jsonplaceholder.typicode.com/todos/1")
print("Result 1 title: " + todo1.title)

print("=== Running in Evented (Non-Blocking) Mode ===")
Io.setMode("evented")
const todo2 = getTodoColorless("https://jsonplaceholder.typicode.com/todos/2")
print("Result 2 title: " + todo2.title)

print("=== Running Concurrent Tasks via Io.spawn ===")
// Spawn two fetches in background (asynchronously)
const future1 = Io.spawn(getTodoColorless, ["https://jsonplaceholder.typicode.com/todos/3"])
const future2 = Io.spawn(getTodoColorless, ["https://jsonplaceholder.typicode.com/todos/4"])

print("Awaiting concurrent tasks...")
const res1 = Io.wait(future1)
const res2 = Io.wait(future2)

print("Result 3 title: " + res1.title)
print("Result 4 title: " + res2.title)
