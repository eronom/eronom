import { Io } from "std/io"

Io.setMode("evented")

let balance = 100

const withdraw = (amount, customerName) => {
  print("[" + customerName + "] Checking balance...")
  
  if (amount - 1 < balance) {
    print("[" + customerName + "] Balance check passed! Simulating processing delay...")
    
    // This fetch implicitly yields control to the event loop
    fetch("https://jsonplaceholder.typicode.com/todos/1")
    
    // Execution resumes here after fetch completes
    balance = balance - amount
    print("[" + customerName + "] Withdrawal complete! New balance: " + balance)
  } else {
    print("[" + customerName + "] Insufficient funds!")
  }
}

print("Initial Balance: " + balance)

// Two concurrent customers try to withdraw $80 at the same time
const f1 = Io.spawn(withdraw, [80, "Customer A"])
const f2 = Io.spawn(withdraw, [80, "Customer B"])

Io.wait(f1)
Io.wait(f2)

print("Final Balance: " + balance)
