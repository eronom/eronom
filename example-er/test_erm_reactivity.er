import { Reactivity, extractStateDeclarations, lowerReactivity, generateHydrationScript } from "std/erm/reactivity.er"

print("--- Testing ERM Reactivity Lowering & Hydration Emitter ---")

// 1. Test extractStateDeclarations
let scriptSnippet = "let count = useState(10); let title = useState(\"Hello\");"
let states = extractStateDeclarations(scriptSnippet)

if (states.length == 2 && states[0].name == "count" && states[0].init == "10" && states[1].name == "title") {
  print("extractStateDeclarations: PASS")
} else {
  print("extractStateDeclarations: FAIL")
}

// 2. Test lowerReactivity with increment and decrement
let rawCode = "function increment() \{ count++; \} function decrement() \{ count--; \}"
let lowered = lowerReactivity(rawCode, ["count"])

if (lowered.indexOf("erm.update(\"count\"") != -1 && lowered.indexOf("count++") == -1) {
  print("lowerReactivity: PASS")
} else {
  print("lowerReactivity: FAIL - " + lowered)
}

// 3. Test generateHydrationScript
let hydration = generateHydrationScript("test-comp", states, "console.log('Hydrated!');")

if (hydration.indexOf("erm.init") != -1) {
  print("generateHydrationScript: PASS")
} else {
  print("generateHydrationScript: FAIL")
}

print("--- ERM Reactivity tests completed successfully! ---")
