struct Position {
    x: int,
    y: int,
    fn printPos() {
        print("x: {this.x}, y: {this.y}")
    }
}

struct AnoStr{
    nameAno: string,
    fn printPlayer() {
        print("Player name from Anostr: {this.nameAno}")
    }
}

struct Player embed AnoStr{
    pos: Position,
    name: string,
    age: int,
    fn printPlayer() {
        print("Player name: {this.name}")
        print("Player age: {this.age}")
        super.printPlayer()
        this.pos.printPos()
    }
}

let p : Player = {
    pos: {
        x: 10,
        y: 20,
    },
    nameAno : "hey name",
    name: "vishnu",
    age: 25,
}

p.printPlayer()


