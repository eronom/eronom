const app = router()

app.get("/async", (c) => {
  setTimeout((ctx) => {
    ctx.json({ message: "Hello from async setTimeout!", status: "success" })
  }, 100, c)
})

app.get("/todo", (c) => {
  fetchAsync("https://jsonplaceholder.typicode.com/todos/1", (res, ctx) => {
    if (res == null) {
      ctx.json({ error: "Fetch failed" })
    } else {
      ctx.json({
        source: "async-fetch",
        todo: res.json()
      })
    }
  }, c)
})
