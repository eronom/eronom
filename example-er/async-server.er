const app = router()

app.get("/async", (c) => {
  setTimeout((ctx) => {
    ctx.json({ message: "Hello from async setTimeout!", status: "success" })
  }, 100, c)
})

app.get("/todo", (c) => {
  const res = fetch("https://jsonplaceholder.typicode.com/todos/1")
  if (res == null) {
    c.json({ error: "Fetch failed" })
  } else {
    c.json({
      source: "io-fetch",
      todo: res.json()
    })
  }
})
