import { Dev, createSnapshot, diffSnapshots, buildHmrPayload, createDevServer } from "std/erm/dev.er"

print("--- Testing ERM Dev Watcher & HMR Broker ---")

// 1. Test createSnapshot on newerm/app/pages
let snap1 = createSnapshot("newerm/app/pages")
let keys = []
for k in snap1 {
  keys.push(k)
}

if (keys.length > 0) {
  print("createSnapshot: PASS (" + keys.length + " files tracked)")
} else {
  print("createSnapshot: FAIL")
}

// 2. Test diffSnapshots with simulated changes
let snap2 = {}
for k in snap1 {
  snap2[k] = snap1[k]
}
// Modify one file timestamp
if (keys.length > 0) {
  snap2[keys[0]] = 999999
}
// Add a new file
snap2["/fake/new_page.erm"] = 12345

let changes = diffSnapshots(snap1, snap2)
if (changes.length == 2) {
  print("diffSnapshots: PASS (detected 2 changes)")
} else {
  print("diffSnapshots: FAIL - " + changes.length)
}

// 3. Test buildHmrPayload
let payload = buildHmrPayload("update", "/app/pages/newr.erm")
if (payload.indexOf("\"type\":\"update\"") != -1 && payload.indexOf("\"path\":\"/app/pages/newr.erm\"") != -1) {
  print("buildHmrPayload: PASS")
} else {
  print("buildHmrPayload: FAIL - " + payload)
}

// 4. Test createDevServer instance
let devServer = createDevServer({
  pagesDir: "newerm/app/pages"
})

if (devServer && typeof devServer.checkChanges == "function") {
  print("createDevServer: PASS")
} else {
  print("createDevServer: FAIL")
}

print("--- ERM Dev Watcher & HMR tests completed successfully! ---")

