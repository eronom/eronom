import { sha256, sha512, md5, hash, hmacSha256, timingSafeEqual, randomUUID, randomBytes, randomHex, randomInt } from "std/crypto"

print("=== Running Eronom SSL & BoringSSL Verification Suite ===")

// 1. Hardware-accelerated Hashing
let h256 = sha256("test-vector-boringssl")
print("✓ SHA-256 hash: " + h256)
if (stringLength(h256) != 64) {
    print("FAILED: SHA-256 length must be 64")
}

let h512 = sha512("test-vector-boringssl")
print("✓ SHA-512 hash length: " + stringLength(h512))
if (stringLength(h512) != 128) {
    print("FAILED: SHA-512 length must be 128")
}

let hmd5 = md5("test-vector-boringssl")
print("✓ MD5 hash: " + hmd5)
if (stringLength(hmd5) != 32) {
    print("FAILED: MD5 length must be 32")
}

// 2. Hardware-accelerated HMAC
let hmac256 = hmacSha256("secret_key", "payload")
print("✓ HMAC-SHA256: " + hmac256)
if (stringLength(hmac256) != 64) {
    print("FAILED: HMAC-SHA256 length must be 64")
}

// 3. Constant-Time Timing-Safe Equality
let eq1 = timingSafeEqual("boringssl-token", "boringssl-token")
let eq2 = timingSafeEqual("boringssl-token", "tampered-token-x")
print("✓ Timing-safe equality: same=" + eq1 + ", diff=" + eq2)
if (!eq1 || eq2) {
    print("FAILED: timingSafeEqual logic incorrect")
}

// 4. Secure Random Number Generation
let u1 = randomUUID()
let u2 = randomUUID()
print("✓ Secure UUID v4: " + u1)
if (stringLength(u1) != 36 || u1 == u2) {
    print("FAILED: UUID v4 uniqueness or format check")
}

let rHex = randomHex(16)
print("✓ Secure random hex (16 bytes): " + rHex)
if (stringLength(rHex) != 32) {
    print("FAILED: Random hex length check")
}

let rInt = randomInt(10, 100)
print("✓ Secure random int in [10, 100): " + rInt)
if (rInt < 10 || rInt >= 100) {
    print("FAILED: Random int range check")
}

// 5. Outbound HTTPS fetch verification against closed port
let fetchRes = fetch("https://127.0.0.1:59999/unreachable")
print("✓ Outbound HTTPS client graceful error handling: " + (fetchRes == null))

print("=== All SSL & BoringSSL Verification Tests Passed Successfully ===")
