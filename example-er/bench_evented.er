import { Io } from "std/io"

const start = () => {
  print("Starting concurrent fetches (evented)...")
  const f1 = Io.spawn(fetch, ["https://jsonplaceholder.typicode.com/todos/1"])
  const f2 = Io.spawn(fetch, ["https://jsonplaceholder.typicode.com/todos/2"])
  const f3 = Io.spawn(fetch, ["https://jsonplaceholder.typicode.com/todos/3"])
  const f4 = Io.spawn(fetch, ["https://jsonplaceholder.typicode.com/todos/4"])
  const f5 = Io.spawn(fetch, ["https://jsonplaceholder.typicode.com/todos/5"])

  print("Awaiting concurrent fetches...")
  Io.wait(f1)
  Io.wait(f2)
  Io.wait(f3)
  Io.wait(f4)
  Io.wait(f5)
  print("Finished concurrent fetches.")
}

start()
