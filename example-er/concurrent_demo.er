import { Io } from "std/io"

const taskA = (url) => {
    print("Starting fetch A...")
    fetch(url)
    print("Completed fetch A!")
}

const taskB = (url) => {
    print("Starting fetch B...")
    fetch(url)
    print("Completed fetch B!")
}

print("--- Native Structured Concurrency Demo ---")

concurrent {
    on taskA("https://jsonplaceholder.typicode.com/todos/1")
    on taskB("https://jsonplaceholder.typicode.com/todos/2")
}

print("All concurrent tasks finished!")
