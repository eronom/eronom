import { Component, injectSlot, ensureDocumentShell } from "std/erm/component.er"

print("--- Testing ERM Component & Slot Engine ---")

// 1. Test injectSlot with self-closing <slot />
let layout1 = "<header>Nav</header><main><slot /></main><footer>Footer</footer>"
let page1 = "<h1>Page Title</h1>"
let result1 = injectSlot(layout1, page1)
if (result1 == "<header>Nav</header><main><h1>Page Title</h1></main><footer>Footer</footer>") {
  print("injectSlot self-closing: PASS")
} else {
  print("injectSlot self-closing: FAIL - " + result1)
}

// 2. Test injectSlot with open/close <slot></slot>
let layout2 = "<div class=\"wrapper\"><slot></slot></div>"
let result2 = injectSlot(layout2, "<p>Content</p>")
if (result2 == "<div class=\"wrapper\"><p>Content</p></div>") {
  print("injectSlot paired: PASS")
} else {
  print("injectSlot paired: FAIL - " + result2)
}

// 3. Test ensureDocumentShell when DOCTYPE is missing
let fragment = "<div id=\"app\">Hello Eronom</div>"
let doc = ensureDocumentShell(fragment, "My Eronom App")
if (doc.indexOf("<!DOCTYPE html>") != -1 && doc.indexOf("<title>My Eronom App</title>") != -1 && doc.indexOf(fragment) != -1) {
  print("ensureDocumentShell wrapping: PASS")
} else {
  print("ensureDocumentShell wrapping: FAIL - " + doc)
}

// 4. Test ensureDocumentShell does not double-wrap complete document
let completeDoc = "<!DOCTYPE html><html><body>Already complete</body></html>"
let noWrap = ensureDocumentShell(completeDoc, "Title")
if (noWrap == completeDoc) {
  print("ensureDocumentShell no-op: PASS")
} else {
  print("ensureDocumentShell no-op: FAIL")
}

print("--- ERM Component tests completed successfully! ---")

