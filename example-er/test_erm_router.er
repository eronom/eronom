import { Router, splitPath, resolveRoute, scanRoutes, createFileSystemRouter } from "std/erm/router.er"

print("--- Testing ERM Script File-System Router ---")

// 1. Test splitPath
let parts = splitPath("/users/123/profile?tab=settings#section")
if (parts.length == 3 && parts[0] == "users" && parts[1] == "123" && parts[2] == "profile") {
  print("splitPath: PASS")
} else {
  print("splitPath: FAIL")
}

// 2. Test createFileSystemRouter on newerm/app/pages (which exists in the repo)
let router = createFileSystemRouter("newerm/app/pages")
if (router && router.baseDir) {
  print("createFileSystemRouter: PASS")
} else {
  print("createFileSystemRouter: FAIL")
}

// 3. Test route resolution for root page
let rootMatch = router.resolve("/")
if (rootMatch && rootMatch.matched) {
  print("resolve root '/': PASS - " + rootMatch.filePath)
} else {
  print("resolve root '/': FAIL")
}

// 4. Test route resolution for specific file (e.g. newr or contact)
let newrMatch = router.resolve("/newr")
if (newrMatch && newrMatch.matched) {
  print("resolve '/newr': PASS - " + newrMatch.filePath)
} else {
  print("resolve '/newr': FAIL")
}

// 5. Test scanning all routes
let allRoutes = router.routes()
if (allRoutes && allRoutes.length > 0) {
  print("scanRoutes found " + allRoutes.length + " routes: PASS")
} else {
  print("scanRoutes: FAIL")
}

print("--- ERM Router tests completed successfully! ---")
