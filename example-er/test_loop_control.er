// Test 1: break in while loop
let w = 0
while (w < 10) {
    if (w == 4) {
        break
    }
    w = w + 1
}
print("While break at: " + w) // Expected: 4

// Test 2: continue in while loop
let c = 0
let sum_even = 0
while (c < 10) {
    c = c + 1
    if (c == 2) {
        continue
    }
    if (c == 4) {
        continue
    }
    if (c == 6) {
        continue
    }
    if (c == 8) {
        continue
    }
    sum_even = sum_even + c
}
print("Sum of non-evens in 1..10 (1+3+5+7+9+10): " + sum_even) // 35

// Test 3: break in for loop
let last_for = 0
for i in 0..10 {
    if (i == 5) {
        break
    }
    last_for = i
}
print("For loop break before 5, last was: " + last_for) // Expected: 4

// Test 4: continue in for loop
let for_sum = 0
for j in 0..6 {
    if (j == 3) {
        continue
    }
    for_sum = for_sum + j
}
print("For loop sum skipping 3 (0+1+2+4+5): " + for_sum) // Expected: 12

// Test 5: Nested loop break and continue
let outer_count = 0
let inner_sum = 0
while (outer_count < 3) {
    outer_count = outer_count + 1
    for k in 0..5 {
        if (k == 2) {
            continue
        }
        if (k == 4) {
            break
        }
        inner_sum = inner_sum + k
    }
}
// For each outer (3 times), inner adds k=0, k=1, k=3 (0+1+3 = 4) -> 4 * 3 = 12
print("Nested inner_sum: " + inner_sum) // Expected: 12
