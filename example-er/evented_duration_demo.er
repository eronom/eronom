import { Io } from "std/io"

print("--- DEMO: Measuring Eronom Evented (Non-Blocking) Duration ---")
Io.setMode("evented")

// 1. Schedule a timer for 100ms
setTimeout(() => {
  print("[Timer] 100ms timer callback executed!")
}, 100)

print("[Main] Scheduled 100ms timer. Now starting 5 sequential evented fetches...")

// 2. Perform 5 sequential evented fetches
fetch("https://jsonplaceholder.typicode.com/todos/1")
print("[Main] Fetch 1 done.")
fetch("https://jsonplaceholder.typicode.com/todos/2")
print("[Main] Fetch 2 done.")
fetch("https://jsonplaceholder.typicode.com/todos/3")
print("[Main] Fetch 3 done.")
fetch("https://jsonplaceholder.typicode.com/todos/4")
print("[Main] Fetch 4 done.")
fetch("https://jsonplaceholder.typicode.com/todos/5")
print("[Main] Fetch 5 done.")

print("[Main] All fetches completed.")
print("")
