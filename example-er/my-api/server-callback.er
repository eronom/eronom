import { router } from "std/http"

let app = router()
let todos = [
  { id: 1, text: "Learn Eronom - dynamic reload worked!ss for itzzzz", done: false }
]

let fetchedTodo = null

const getTodos = () => {
  fetch('https://jsonplaceholder.typicode.com/todos/1', (todo) => {
    fetchedTodo = todo.json()
    print(fetchedTodo)
  })
}

getTodos()

// GET all todos
app.get('/todos', (c) => {
  return c.json(todos)
})

app.listen(3000, () => {
  print('Server running on port 3000')
})
