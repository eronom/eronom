import { router } from "std/http"
import { Io } from "std/io"

let app = router()
let todos = [
  { id: 1, text: "Learn Eronom - dynamic reload worked!ss for itzzzz", done: false }
]

Io.setMode("threaded")

const getTodos = () => {
  const todo = fetch('https://jsonplaceholder.typicode.com/todos/1')
  print(todo)
}

getTodos()

// GET all todos
app.get('/todos', (c) => {
  return c.json(todos)
})

app.listen(3000, () => {
  print('Server running on port 3000')
})
