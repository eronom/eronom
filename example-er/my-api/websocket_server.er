import { router } from "std/http"

let app = router()

app.ws('/ws', {
  open: (ws) => {
    print("WebSocket connection opened")
  },
  message: (ws, msg) => {
    print("Received message: " + msg)
    ws.send("Echo: " + msg)
  },
  close: (ws, code, reason) => {
    print("WebSocket closed")
  }
})
