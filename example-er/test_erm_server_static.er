import { Server, createHandler } from "std/erm/server.er"
import { Static, buildStatic } from "std/erm/static.er"
import { exists, readFile, removeFile, rmdir } from "std/fs.er"
import { join } from "std/path.er"

print("--- Testing ERM SSR Server & SSG Engine ---")

// 1. Test createHandler for newerm/app/pages
let handler = createHandler({
  pagesDir: "newerm/app/pages",
  title: "Test Site"
})

if (handler && typeof handler == "function") {
  print("createHandler initialization: PASS")
} else {
  print("createHandler initialization: FAIL")
}

// 2. Dispatch simulated request to root "/"
let resRoot = handler({ path: "/" })
if (resRoot && resRoot.status == 200 && resRoot.headers["content-type"] == "text/html; charset=utf-8") {
  print("SSR root request 200: PASS")
} else {
  print("SSR root request 200: FAIL")
}

// 3. Dispatch simulated request to non-existent route
let res404 = handler({ path: "/not-found-route" })
if (res404 && res404.status == 404) {
  print("SSR 404 handling: PASS")
} else {
  print("SSR 404 handling: FAIL")
}

// 4. Test Static Site Generation (SSG) output into test_dist
let ssgResult = buildStatic({
  pagesDir: "newerm/app/pages",
  outDir: "test_dist",
  title: "SSG Test"
})

if (ssgResult && ssgResult.success && ssgResult.count > 0) {
  print("SSG buildStatic generation (" + ssgResult.count + " pages): PASS")
  let indexFile = join("test_dist", "index.html")
  if (exists(indexFile)) {
    print("SSG output index.html exists: PASS")
    // Clean up test_dist
    removeFile(indexFile)
  }
} else {
  print("SSG buildStatic generation: FAIL")
}

// Clean up remaining test_dist files
let newrOut = join("test_dist", "newr/index.html")
if (exists(newrOut)) {
  removeFile(newrOut)
  rmdir(join("test_dist", "newr"))
}
if (exists("test_dist")) {
  rmdir("test_dist")
}

print("--- ERM SSR & SSG tests completed successfully! ---")
