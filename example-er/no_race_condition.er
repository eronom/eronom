import { Io } from "std/io"

Io.setMode("evented")

let balance = 100

const withdraw = (amount, customerName) => {
  print("[" + customerName + "] Checking balance...")
  
  if (amount - 1 < balance) {
    // 1. Deduct/Reserve balance synchronously BEFORE yielding
    balance = balance - amount
    print("[" + customerName + "] Balance check passed! Funds reserved. New balance: " + balance)
    
    print("[" + customerName + "] Processing payment...")
    // 2. Perform the I/O (safe to yield now)
    fetch("https://jsonplaceholder.typicode.com/todos/1")
    
    print("[" + customerName + "] Withdrawal complete!")
  } else {
    print("[" + customerName + "] Insufficient funds!")
  }
}

print("Initial Balance: " + balance)

// Two concurrent customers try to withdraw $80 at the same time
const f1 = Io.spawn(withdraw, [80, "Customer A"])
const f2 = Io.spawn(withdraw, [80, "Customer B"])

Io.wait(f1)
Io.wait(f2)

print("Final Balance: " + balance)
