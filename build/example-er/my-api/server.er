import { route } from "std/http"

let app = route()
let todos = [
  { id: 1, text: "Learn Eronom - dynamic reload worked!ss for itzzzz", done: false }
]

const getTodos = () => {
  const todo = fetch('https://jsonplaceholder.typicode.com/todos/1')
  print(todo)
}

getTodos()

// GET all todos
app.get('/todos', (c) => {
  return c.json(todos)
})

