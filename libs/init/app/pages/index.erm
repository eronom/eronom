<script>
    let activeTheme = useState('light');

    let count = useState(0);
    let double = useState(() => count * 2);
    let todoText = useState('');
    let todos = useState([]);
    
    async function fetchTodos() {
        try {
            const res = await fetch('/api/todo');
            todos = await res.json();
        } catch (e) {
            console.error("Failed to fetch todos:", e);
        }
    }
    fetchTodos();
    
    let showExtraContent = useState(true);
    let porridge = useState({ temperature: 100 });
    




    document.addEventListener('DOMContentLoaded', () => {
        const app = document.getElementById('app');
        if (app) {
            const timeDisplay = document.createElement('h3');
            app.appendChild(timeDisplay);
            setInterval(() => {
                timeDisplay.innerText = "Current time: " + new Date().toLocaleTimeString();
            }, 1);
        }
    
    });

    // TEST: Background updates now work automatically!
    let timer = useState(0);
    setInterval(() => {
        timer++;
    }, 1000);

    let randomNum = Math.floor(Math.random() * 1000);
    let items = useState([1, 2, 3, 4, 5]);
</script>


<h1>HMRssssvvvvvssssvs is now running from a dedicated server module!</h1>
<h2>hello</h2>
<p>vcbc fdh scvxhhhhhhhhhhhhhh
fdvchgvyufdnb
gvfcjb hyun</p>
<p>helloo DHBVYUCBHNFDBVH BHYU</p>
<div style="padding: 20px; border: 2px solid cyan; border-radius: 10px; margin-bottom: 20px;">
    <h3>Reactive Signal Demo</h3>
    <button onClick={()=>{count++}}>Count {count}</button>
    <p>Double (Count * 2): <strong>{double}</strong></p>
    <p>Background Timer: <strong>{timer}s</strong></p>
</div>

<p>HMRsss is now EFddFIaaCIENTss and CLEAN! Edited <code>index.erm</code>.</p>
<div id="app"></div>
<h2>Hellloo web added h2 tag</h2>
<p>Random: {randomNum}</p>
<h2>Hwwwssselaaaaaallsvvsssssssvvvvsssssssssssooooooovvvv wesb added h2paaaaaaaaaaaaaaaaaaaappppppssppppppppppk tag</h2>
<h2>Hellsslssvvaaaaavslo weaaaaaaab added h2 tag</h2>

<div style="padding: 20px; border: 2px solid #3498db; border-radius: 10px; margin-bottom: 20px;">
    <h3>For Loop Demo</h3>
    <div style="margin-bottom: 10px;">
        <button onClick={()=>{items.push(items.length + 1)}}>Add Item</button>
        <button onClick={()=>{items.pop()}}>Remove Item</button>
    </div>

    {#for item,i in items}
        <p>Item key as {i} : {item}</p>
    {/for}
</div>

<h1>hello api todos </h1>

<div style="padding: 20px; border: 2px solid #e67e22; border-radius: 10px; margin-bottom: 20px;">
    <h3>API Todo Demosss (from <code>/api/todo</code>)</h3>
    <button onClick={fetchTodos}>Refresh API Todos</button>
    <div style="margin-top: 10px;">
        {#for todo in todos}
            <div style="padding: 10px; background: #2c3e50; border-radius: 5px; margin-bottom: 5px; color: white;">
                <strong>{todo.text}</strong> - {todo.done ? '✅' : '❌'}
            </div>
        {/for}
    </div>
</div>

{#if porridge.temperature > 100}
    <p>too hot!</p>
{:else if 80 > porridge.temperature}
    <p>too cold!</p>
{:else}
    <p>just right!</p>
{/if}

<Link to="/contact">Contact</Link>

<style>
    .demo-box {
        padding: 24px;
        border-radius: 16px;
        margin-top: 20px;
        margin-bottom: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(4px);
        transition: all 0.3s ease;
    }
    .context-demo {
        border-color: rgba(155, 93, 229, 0.3);
    }
    .context-demo:hover {
        border-color: rgba(155, 93, 229, 0.6);
        box-shadow: 0 12px 40px 0 rgba(155, 93, 229, 0.15);
    }
    .demo-desc {
        color: #a0aec0;
        font-size: 0.95rem;
        margin-top: 4px;
        margin-bottom: 16px;
    }
    .control-row {
        margin-bottom: 20px;
    }
    .btn {
        padding: 10px 20px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .theme-btn {
        background: linear-gradient(135deg, #9b5de5, #f15bb5);
        color: white;
        box-shadow: 0 4px 14px rgba(155, 93, 229, 0.4);
    }
    .theme-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(155, 93, 229, 0.6);
    }
    .theme-btn:active {
        transform: translateY(0);
    }
</style>

<ContextProvider context={activeTheme} value={activeTheme}>
    <div class="demo-box context-demo">
        <h3>🌐 Context API Demo</h3>
        <p class="demo-desc">Changing the state below propagates the value to child components via <code>activeTheme</code>.</p>
        <div class="control-row">
            <button class="btn theme-btn" onClick={()=>{activeTheme = activeTheme == 'light' ? 'dark' : 'light'}}>
                Toggle Theme (Current: {activeTheme})
            </button>
        </div>
        <Header />
    </div>
</ContextProvider>

{#if showExtraContent}
    <div id="extra-content" style="margin-top: 20px; padding: 15px; border: 2px dashed #42b983;">
        <h3>🎉 Condsfssitsionalssssssss Rendered Boxxxxxssaaa</h3>
        <p>This block only loads because <code>showExtraContent</code> is <strong>true</strong>.</p>
    </div>
    <button onclick={()=>{showExtraContent=false}}>Hide Content</button>
{:else}
    <div><p>showExtraContent is false</p></div>
    <button onclick={()=>{showExtraContent=true}}>Show Content</button>
{/if}




<Footer />
