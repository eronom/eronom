        backdrop-filter: blur(4px);
        transition: all 0.3s ease;
    }
    .context-demo {
        border-color: rgba(155, 93, 229, 0.3);
    }
    .context-demo:hover {
        border-color: rgba(155, 93, 229, 0.6);
        box-shadow: 0 12px 40px 0 rgba(155, 93, 229, 0.15);
    }
    .demo-desc {
        color: #a0aec0;
        font-size: 0.95rem;
