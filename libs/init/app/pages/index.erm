<Center as="main" screen p="xl" bg="body">
    <Card maw="md" p="2xl">
        <Stack gap="md" align="center" ta="center">
            <Badge status="info">Eronom ⚡ v0.9</Badge>
            <Title order="1" fz="3xl" fw="bold" c="primary">
                Get started by editing<br />
                <Code>app/pages/index.erm</Code>
            </Title>
            <Text variant="body" c="secondary">
                Save and see changes instantly. Powered by the Eronom Design System (EDS) with compiler-enforced intent tokens and native dual-theme support.
            </Text>
            <Group gap="md" align="center" mt="md">
                <Button as="a" href="https://github.com/eronom/eronom" target="_blank" rel="noopener noreferrer" variant="primary" size="md" px="24px" py="10px">
                    Documentation &rarr;
                </Button>
                <Button as="a" href="https://github.com/eronom/eronom" target="_blank" rel="noopener noreferrer" variant="secondary" size="md" px="24px" py="10px">
                    Explore Templates
                </Button>
            </Group>
        </Stack>
    </Card>
</Center>
