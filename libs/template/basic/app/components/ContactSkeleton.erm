<div class="skeleton-wrapper">
  <div class="skeleton-header"></div>
  <div class="skeleton-body">
    <div class="skeleton-line"></div>
    <div class="skeleton-line"></div>
    <div class="skeleton-line last"></div>
  </div>
</div>

<style>
  .skeleton-wrapper {
    width: 100%;
    padding: 20px;
    box-sizing: border-box;
  }

  .skeleton-header {
    height: 32px;
    width: 60%;
    background: linear-gradient(90deg, rgba(0, 102, 255, 0.08) 25%, rgba(0, 102, 255, 0.2) 37%, rgba(0, 102, 255, 0.08) 63%);
    background-size: 400% 100%;
    animation: skeleton-loading 1.4s ease infinite;
    border-radius: 8px;
    margin-bottom: 24px;
  }

  .skeleton-line {
    height: 18px;
    width: 100%;
    background: linear-gradient(90deg, rgba(0, 102, 255, 0.08) 25%, rgba(0, 102, 255, 0.2) 37%, rgba(0, 102, 255, 0.08) 63%);
    background-size: 400% 100%;
    animation: skeleton-loading 1.4s ease infinite;
    border-radius: 6px;
    margin-bottom: 12px;
  }

  .skeleton-line.last {
    width: 80%;
  }

  @keyframes skeleton-loading {
    0% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>
