<script>
    import ContactSkeleton from "../components/ContactSkeleton.erm";
    let name = useState('');
    let email = useState('');
    let message = useState('');
    let submitted = useState(false);
    let errorMsg = useState('');

    let isSlowDataLoaded = useState(false);
    async function loadSlowData() {
        try {
            await fetch('/api/slow');
            isSlowDataLoaded.value = true;
        } catch (e) {
            console.error("Failed to fetch slow data:", e);
        }
    }
    loadSlowData();

    function handleSubmit(e) {
        if (e) e.preventDefault();
        
        if (!name.value || !email.value || !message.value) {
            errorMsg.value = "Please fill in all fields.";
            return;
        }
        
        errorMsg.value = "";
        
        // Directly manipulate DOM for the premium submitting animation
        const btn = document.querySelector('.submit-btn');
        if (btn) {
            btn.disabled = true;
            const btnText = btn.querySelector('.btn-text');
            if (btnText) btnText.innerText = "Sending...";
            const spinner = btn.querySelector('.spinner');
            if (spinner) spinner.style.display = "inline-block";
        }
        
        setTimeout(() => {
            submitted.value = true;
        }, 1500);
    }
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    .contact-container {
        font-family: 'Outfit', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 550px;
        margin: 40px auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .contact-card {
        background: rgba(25, 25, 35, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .contact-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #38ef7d, #11998e);
    }

    .title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 8px;
        background: linear-gradient(135deg, #ffffff 30%, #a5a5a5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }

    .subtitle {
        color: #8892b0;
        font-size: 1rem;
        margin-bottom: 32px;
        font-weight: 300;
    }

    .form-group {
        margin-bottom: 24px;
        position: relative;
    }

    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: #ccd6f6;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .form-input, .form-textarea {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 14px 16px;
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-input:focus, .form-textarea:focus {
        outline: none;
        border-color: #11998e;
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 0 4px rgba(17, 153, 142, 0.15);
    }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .error-banner {
        background: rgba(255, 107, 107, 0.1);
        border: 1px solid rgba(255, 107, 107, 0.2);
        color: #ff6b6b;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
        margin-bottom: 24px;
        box-sizing: border-box;
        width: 100%;
        display: block;
    }

    .error-banner:empty {
        display: none !important;
    }

    .error-banner:not(:empty)::before {
        content: '⚠️ ';
        margin-right: 8px;
    }

    .submit-btn {
        width: 100%;
        background: linear-gradient(90deg, #11998e, #38ef7d);
        border: none;
        border-radius: 12px;
        padding: 16px;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 20px rgba(56, 239, 125, 0.2);
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(56, 239, 125, 0.4);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    .success-container {
        text-align: center;
        padding: 20px 0;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        background: rgba(56, 239, 125, 0.1);
        border: 2px solid #38ef7d;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 24px;
        color: #38ef7d;
        font-size: 2.5rem;
        box-shadow: 0 0 20px rgba(56, 239, 125, 0.2);
    }

    .success-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 12px;
        color: #ffffff;
    }

    .success-text {
        color: #8892b0;
        font-size: 1.1rem;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .home-link-container {
        display: flex;
        justify-content: center;
        margin-top: 24px;
    }

    .home-link {
        color: #11998e;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .home-link:hover {
        color: #38ef7d;
    }

    /* Loader styling */
    .spinner {
        border: 3px solid rgba(15, 23, 42, 0.3);
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border-left-color: #0f172a;
        animation: spin 1s linear infinite;
        margin-left: 10px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<Header />

<div class="contact-container">
    <div class="contact-card">
        <Suspense fallback={<ContactSkeleton />}>
            if submitted {
                <div class="success-container">
                    <div class="success-icon">✓</div>
                    <h3 class="success-title">Message Sent!</h3>
                    <p class="success-text">Thank you for reaching out, <strong>{name}</strong>. We have received your query and will get back to you shortly.</p>
                    <Link to="/" class="submit-btn" style="text-decoration: none; text-align: center;">Back to Home</Link>
                </div>
            } else {
                <h2 class="title">Get in touch</h2>
                <p class="subtitle">Have a question or want to work together? Let us know.</p>
                <p style="color: #38ef7d; font-size: 0.95rem; margin-top: -16px; margin-bottom: 24px; font-weight: 500; text-shadow: 0 0 10px rgba(56, 239, 125, 0.2);">
                    Status: {isSlowDataLoaded ? '✓ API Data Synced' : '⚡ Syncing API Data...'}
                </p>
                
                <span class="error-banner">{errorMsg}</span>

                <form onSubmit={handleSubmit}>
                    <div class="form-group">
                        <label class="form-label" for="name">Name</label>
                        <input class="form-input" id="name" type="text" placeholder="Enter your name" value={name} onInput={(e) => { name = e.target.value; }} />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">Email Address</label>
                        <input class="form-input" id="email" type="email" placeholder="you@example.com" value={email} onInput={(e) => { email = e.target.value; }} />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="message">Message</label>
                        <textarea class="form-textarea" id="message" placeholder="Type your message here..." value={message} onInput={(e) => { message = e.target.value; }}></textarea>
                    </div>

                    <button class="submit-btn" type="submit">
                        <span class="btn-text">Send Message</span>
                        <div class="spinner" style="display: none;"></div>
                    </button>
                </form>
            }
        </Suspense>

        <div class="home-link-container">
            <Link to="/" class="home-link">← Go Back Home</Link>
        </div>
    </div>
</div>

<Footer />
